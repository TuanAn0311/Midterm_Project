<html lang="vi">
    <head>
        <meta charset="UTF-8" />
        <title>Quản lý Sách</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                margin: 30px auto;
                max-width: 800px;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 15px;
            }
            th,
            td {
                border: 1px solid #ddd;
                padding: 8px;
                text-align: left;
            }
            th {
                background-color: #f2f2f2;
            }
            .btn {
                background: #007bff;
                color: white;
                border: none;
                padding: 8px 16px;
                cursor: pointer;
            }
            footer {
                margin-top: 40px;
                padding: 15px;
                border-top: 2px solid #333;
                background: #f9f9f9;
            }
            .error {
                color: red;
                font-weight: bold;
                margin-bottom: 10px;
            }
        </style>
    </head>
    <body>
        {{{body}}}

        <footer>
            <p><strong>Họ và tên:</strong> {{studentName}} | <strong>MSSV:</strong> {{mssv}} | <strong>Mức VAT áp dụng:</strong> {{vatRate}}%</p>
        </footer>
    </body>
</html>